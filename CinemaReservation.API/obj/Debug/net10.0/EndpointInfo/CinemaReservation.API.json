  "components": {
    "schemas": {
      "CreateCommentDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "rating": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "CreateMovieDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "posterUrl": {
            "type": "string"
          },
          "genre": {
            "type": "string"
          },
          "durationInMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "CreateReservationDto": {
        "type": "object",
        "properties": {
          "showtimeId": {
            "type": "string",
            "format": "uuid"
          },
          "seatIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "CreateShowtimeDto": {
        "type": "object",
        "properties": {
          "startTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "LoginUserDto": {
        "type": "object",
        "properties": {
